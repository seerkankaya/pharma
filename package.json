{
  "name": "scalpiq-pharma",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "npm run dev -w @scalpiq/api",
    "web": "npm run dev -w @scalpiq/web",
    "kurulum": "tsx apps/api/src/kurulum.ts",
    "test:vt": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://scalpiq:scalpiq@127.0.0.1:5432/scalpiq_test} vitest run apps/api/test/vt.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
